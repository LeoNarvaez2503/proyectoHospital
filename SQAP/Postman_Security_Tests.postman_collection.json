              "raw": "{\n  \"Id\": 0,\n  \"Nombre\": \"<script>alert('XSS_RAW')</script>\",\n  \"Apellido\": \"PruebaRAW\",\n  \"Cedula\": \"0999999999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": { "raw": "http://localhost:5076/Pacientes/GuardarPaciente", "protocol": "http", "host": ["localhost"], "port": "5076", "path": ["Pacientes", "GuardarPaciente"] }
          }
        },
        {
          "name": "XSS-02: Inyección de Atributo Evento HTML (onerror=alert)",
