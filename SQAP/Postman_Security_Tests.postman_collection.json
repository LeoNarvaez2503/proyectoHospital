          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Sanitización XSS en JSON RAW', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('<script>alert(\"XSS_RAW\")</script>');",
                  "});"
