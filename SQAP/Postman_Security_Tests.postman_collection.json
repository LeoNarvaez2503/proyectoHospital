    {
      "name": "⚠️ 4. Pruebas de Limites, Validaciones y Casos de Fallo DTO",
      "item": [
        {
          "name": "VAL-01: [Fallo Controlado] Registro con Confirmación de Clave Errónea",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta HTTP 200 indicando rechazo de registro', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Debe mostrar alerta de no coincidencia', function () {",
                  "    pm.expect(pm.response.text()).to.include('coincide') || pm.expect(pm.response.text()).to.not.include('Exito');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "correo", "value": "usuario_nuevo@hospital.com", "type": "text" },
                { "key": "clave", "value": "PasswordSegura123!", "type": "text" },
                { "key": "confClave", "value": "PasswordDiferente999!", "type": "text" }
              ]
            },
            "url": { "raw": "http://localhost:5076/Acceso/Registrar", "protocol": "http", "host": ["localhost"], "port": "5076", "path": ["Acceso", "Registrar"] }
          }
        },
        {
          "name": "VAL-02-RAW: [Fallo Controlado] Buffer Overflow en RAW Payload (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Manejo controlado de Payload JSON masivo', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 415, 500]);",
                  "    pm.expect(pm.response.text()).to.not.include('Fatal crash');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Id\": 0,\n  \"Nombre\": \"TestOverflowRAW\",\n  \"Cedula\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": { "raw": "http://localhost:5076/Pacientes/GuardarPaciente", "protocol": "http", "host": ["localhost"], "port": "5076", "path": ["Pacientes", "GuardarPaciente"] }
          }
        },
        {
          "name": "VAL-03: [Fallo Controlado] Petición de Eliminación con ID Negativo (-1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Manejo controlado de ID inválido', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('NullReferenceException');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "id", "value": "-1", "type": "text" }
              ]
            },
            "url": { "raw": "http://localhost:5076/Pacientes/EliminarPaciente", "protocol": "http", "host": ["localhost"], "port": "5076", "path": ["Pacientes", "EliminarPaciente"] }
          }
        }
      ]
    }
